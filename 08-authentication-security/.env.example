# 08-authentication-security Environment Configuration Template
# Copy this file to .env and customize local runtime variables.
# NEVER COMMIT REAL SECRETS, TOKENS, OR CREDENTIALS TO VERSION CONTROL.

APP_SECRET_KEY=your-secret-key-here-minimum-32-chars-long
APP_ENVIRONMENT=development
SESSION_TTL_SECONDS=3600
DATABASE_URL=sqlite:///app_dev.db
LOG_LEVEL=INFO
